# Public canonical site URL.
NEXT_PUBLIC_SITE_URL=https://vivatrip.vercel.app

# Public Supabase connection values.
# Copy this file to .env.local and fill the values from Supabase Project Settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only AI configuration. Never prefix these values with NEXT_PUBLIC_.
# OpenAI is the default because VivaTrip Phase 2A was designed around AI_API_KEY.
# You may switch to Gemini by setting AI_PROVIDER=gemini and GEMINI_API_KEY.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-5.4

# Optional Gemini alternative. Used only when AI_PROVIDER=gemini.
GEMINI_API_KEY=

# Optional future production integrations (leave empty until configured).
# Real flight prices/alerts require a licensed provider; do not fabricate availability.
FLIGHTS_PROVIDER=
FLIGHTS_API_KEY=
EMAIL_PROVIDER=
EMAIL_API_KEY=

# Optional places/photos/maps provider for verified place metadata.
PLACES_PROVIDER=
PLACES_API_KEY=
